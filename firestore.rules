rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasValidOwnership(data, uid) {
      return data.get('userId', uid) == uid
        && data.get('uid', uid) == uid;
    }

    function validStringField(data, field, maxSize) {
      return !data.keys().hasAny([field])
        || (data[field] is string && data[field].size() <= maxSize);
    }

    function validListField(data, field, maxSize) {
      return !data.keys().hasAny([field])
        || (data[field] is list && data[field].size() <= maxSize);
    }

    function validCommonShape(data, documentId) {
      return data.get('id', documentId) == documentId
        && validStringField(data, 'title', 2000)
        && validStringField(data, 'name', 1000)
        && validStringField(data, 'question', 5000)
        && validStringField(data, 'summary', 20000)
        && validStringField(data, 'description', 100000)
        && validStringField(data, 'body', 500000)
        && validListField(data, 'tags', 200)
        && validListField(data, 'conceptIds', 500)
        && validListField(data, 'sourceIds', 500)
        && validListField(data, 'questionIds', 500)
        && validListField(data, 'positionIds', 500);
    }

    function allowedWorkspaceCollection(collectionId) {
      return collectionId == 'media'
        || collectionId == 'annotations'
        || collectionId == 'concepts'
        || collectionId == 'questions'
        || collectionId == 'vault'
        || collectionId == 'drafts'
        || collectionId == 'practices'
        || collectionId == 'practiceLogs'
        || collectionId == 'workRevisions'
        || collectionId == 'positionVersions'
        || collectionId == 'atlasMaps'
        || collectionId == 'links'
        || collectionId == 'timeline'
        || collectionId == 'insights'
        || collectionId == 'thinkingEvents'
        || collectionId == 'beliefProfiles'
        || collectionId == 'unknowns'
        || collectionId == 'thinkingPatterns'
        || collectionId == 'thinkingMetrics'
        || collectionId == 'settings'
        || collectionId == 'profile';
    }

    function validBoundedHistories(data) {
      return validListField(data, 'aiReviewHistory', 500)
        && validListField(data, 'annotations', 200)
        && validListField(data, 'logs', 180)
        && validListField(data, 'evidenceRecords', 200)
        && validListField(data, 'versionHistory', 100);
    }

    function validOwnedWrite(uid, documentId) {
      return isOwner(uid)
        && hasValidOwnership(request.resource.data, uid)
        && validCommonShape(request.resource.data, documentId)
        && validBoundedHistories(request.resource.data);
    }

    function validPublicProfile(data, slug) {
      return data.keys().hasOnly([
          'id', 'ownerId', 'shareSlug', 'enabled', 'displayName', 'avatarUrl',
          'bio', 'philosophyName', 'philosophyNameStatus', 'philosophyStatement',
          'currentSeason', 'themes', 'concepts', 'positions', 'works', 'practices',
          'sources', 'beliefHistory', 'updatedAt'
        ])
        && data.id == slug
        && data.shareSlug == slug
        && data.enabled is bool
        && validStringField(data, 'displayName', 200)
        && validStringField(data, 'avatarUrl', 4096)
        && validStringField(data, 'bio', 2000)
        && validStringField(data, 'philosophyName', 200)
        && validStringField(data, 'philosophyNameStatus', 20)
        && validStringField(data, 'philosophyStatement', 5000)
        && validStringField(data, 'currentSeason', 300)
        && validStringField(data, 'updatedAt', 100)
        && validListField(data, 'themes', 12)
        && validListField(data, 'concepts', 12)
        && validListField(data, 'positions', 12)
        && validListField(data, 'works', 12)
        && validListField(data, 'practices', 12)
        && validListField(data, 'sources', 12)
        && validListField(data, 'beliefHistory', 12);
    }

    // Server-controlled usage counters are never readable or writable by clients.
    match /apiUsage/{counterId} {
      allow read, write: if false;
    }

    // Deliberately limited snapshots are shared by URL, not through a directory.
    // Private workspace documents remain isolated under /users/{uid}.
    match /publicProfiles/{slug} {
      allow get: if resource.data.enabled == true
        || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && validPublicProfile(request.resource.data, slug);
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && validPublicProfile(request.resource.data, slug);
      allow delete: if signedIn() && (resource == null || resource.data.ownerId == request.auth.uid);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if validOwnedWrite(uid, uid);
      allow delete: if false;

      match /aiProvenance/{provenanceId} {
        function hasMatchingAcceptance() {
          let eventPath = /databases/$(database)/documents/users/$(uid)/thinkingEvents/$(provenanceId);
          let event = getAfter(eventPath).data;
          return event != null && event.origin == 'ai-assisted'
            && event.userId == uid
            && event.metadata.provenanceId == provenanceId;
        }

        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.id == provenanceId
          && request.resource.data.provenanceId == provenanceId
          && request.resource.data.userId == uid
          && request.resource.data.schemaVersion == 1
          && request.resource.data.kind == 'ai-assisted'
          && request.resource.data.state == 'active'
          && request.resource.data.acceptedAt == request.time
          && request.resource.data.acceptedTextHash is string
          && request.resource.data.acceptedTextHash.size() == 64
          && validListField(request.resource.data, 'targets', 500)
          && request.resource.data.targets.size() > 0
          && validStringField(request.resource.data, 'acceptedText', 32000)
          && (request.resource.data.precursor == null || (
            request.resource.data.precursor is string && request.resource.data.precursor.size() <= 32000
          ))
          && hasMatchingAcceptance();
        allow update: if isOwner(uid)
          && resource.data.userId == uid
          && resource.data.state in ['active', 'redacted']
          && request.resource.data.state == 'redacted'
          && request.resource.data.precursor == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['precursor', 'state']);
      }

      match /thinkingEvents/{eventId} {
        function validProvenanceReference() {
          let reference = request.resource.data.get('metadata', {}).get('provenanceId', null);
          return reference == null || matchesOrigin(reference);
        }

        function matchesOrigin(reference) {
          let originPath = /databases/$(database)/documents/users/$(uid)/aiProvenance/$(eventId);
          let origin = getAfter(originPath).data;
          return reference == eventId && request.resource.data.origin == 'ai-assisted'
            && origin != null && origin.provenanceId == eventId && origin.userId == uid;
        }

        allow read: if isOwner(uid);
        allow create: if validOwnedWrite(uid, eventId) && validProvenanceReference() && (
          request.resource.data.get('demoSeed', false) == true
          || (
            request.resource.data.eventId == eventId
            && request.resource.data.actorId == uid
            && request.resource.data.schemaVersion == 2
            && request.resource.data.summary is string
            && request.resource.data.summary.size() <= 2000
          )
        );
        // Production history is immutable. Deterministic demo records may be
        // refreshed only while remaining explicitly marked as seeded data.
        allow update: if isOwner(uid)
          && resource.data.get('demoSeed', false) == true
          && request.resource.data.get('demoSeed', false) == true
          && request.resource.data.eventId == eventId;
        allow delete: if isOwner(uid) && resource.data.get('demoSeed', false) == true;
      }

      match /{collectionId}/{documentId} {
        allow read: if isOwner(uid);
        allow create, update: if allowedWorkspaceCollection(collectionId)
          && collectionId != 'thinkingEvents'
          && validOwnedWrite(uid, documentId);
        allow delete: if allowedWorkspaceCollection(collectionId)
          && collectionId != 'thinkingEvents'
          && isOwner(uid);
      }

      // No unreviewed deeply nested collection receives an implicit write grant.
      match /{document=**} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
