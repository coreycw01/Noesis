# Firebase browser configuration (public identifiers)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Enable only after the public site key is available during the client build.
NOESIS_REQUIRE_APP_CHECK=false

# Server-only provider credentials
GEMINI_API_KEY=
GEMINI_MODEL=googleai/gemini-2.5-flash
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# Local server development only. App Hosting uses application-default credentials.
GOOGLE_APPLICATION_CREDENTIALS=
